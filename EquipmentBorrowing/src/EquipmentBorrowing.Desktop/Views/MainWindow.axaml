<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Campus Equipment Borrowing System"
        Width="900" Height="600">
    <Grid ColumnDefinitions="180,*">
        <StackPanel Grid.Column="0" Spacing="4" Margin="8">
            <Button Content="Equipment" Command="{Binding ShowEquipmentCommand}" />
            <Button Content="Borrowings" Command="{Binding ShowBorrowingsCommand}" />
        </StackPanel>

        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
    </Grid>
</Window>