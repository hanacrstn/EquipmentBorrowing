<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Campus Equipment Borrowing System"
        Width="900" Height="600">
    <Grid ColumnDefinitions="180,*" Margin="10">
        <StackPanel Grid.Column="0"
            Margin="59"
            Spacing="4" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top">
            <Button Content="Equipment" 
                Command="{Binding ShowEquipmentCommand}" 
                Width="140"
                HorizontalContentAlignment="Center" />
            
            <Button Content="Borrowings" 
                    Command="{Binding ShowBorrowingsCommand}" 
                    Width="140"
                    HorizontalContentAlignment="Center" />
        </StackPanel>

        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
    </Grid>
</Window>