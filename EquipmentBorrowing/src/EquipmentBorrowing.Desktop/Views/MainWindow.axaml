<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Campus Equipment Borrowing System"
        Width="1000" Height="650"
        MinWidth="800" MinHeight="500">
    <Grid ColumnDefinitions="220,*">
        <StackPanel Grid.Column="0" Classes="NavPanel">
            <TextBlock Text="CampusEquipment Borrowing" FontWeight="Bold" FontSize="16"
                       Margin="16,20,16,24" TextWrapping="Wrap" />
            <Button Classes="NavButton" Content="Equipment" Command="{Binding ShowEquipmentCommand}" />
            <Button Classes="NavButton" Content="Active Borrowings" Command="{Binding ShowBorrowingsCommand}" />
        </StackPanel>

        <Border Grid.Column="1" Padding="24">
            <ContentControl Content="{Binding CurrentView}" />
        </Border>
    </Grid>
</Window>