<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:domain="using:EquipmentBorrowing.Domain"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <TextBlock Grid.Row="0" Classes="Heading" Text="Equipment" />

        <Border Grid.Row="1" Classes="Card" Margin="0,0,0,20">
            <StackPanel Spacing="12">
                <TextBlock Classes="SubHeading" Text="Borrow Equipment" />

                <WrapPanel ItemSpacing="12" LineSpacing="12">
                    <StackPanel MinWidth="180">
                        <TextBlock Classes="FieldLabel" Text="STUDENT" />
                        <ComboBox ItemsSource="{Binding Students}"
                                  SelectedItem="{Binding SelectedStudent}"
                                  PlaceholderText="Select student"
                                  Width="180">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel MinWidth="180">
                        <TextBlock Classes="FieldLabel" Text="EQUIPMENT" />
                        <ComboBox ItemsSource="{Binding Equipment}"
                                  SelectedItem="{Binding SelectedEquipment}"
                                  PlaceholderText="Select equipment"
                                  Width="180">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel MinWidth="180">
                        <TextBlock Classes="FieldLabel" Text="RETURN BY" />
                        <DatePicker SelectedDate="{Binding ExpectedReturnDate}" Width="180" />
                    </StackPanel>
                </WrapPanel>

                <Button Classes="Primary" Content="Borrow Equipment" Command="{Binding BorrowCommand}" />
                <TextBlock Classes="StatusMessage" Text="{Binding StatusMessage}"
                           IsVisible="{Binding StatusMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="Card">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="SubHeading" Text="Inventory" />

                <Grid DockPanel.Dock="Top" ColumnDefinitions="60,*,100" Margin="12,0,12,8">
                    <TextBlock Grid.Column="0" Text="ID" Classes="FieldLabel" />
                    <TextBlock Grid.Column="1" Text="NAME" Classes="FieldLabel" />
                    <TextBlock Grid.Column="2" Text="STATUS" Classes="FieldLabel" HorizontalAlignment="Right" />
                </Grid>

                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Equipment}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="domain:Equipment">
                                <Border Classes="ListRow">
                                    <Grid ColumnDefinitions="60,*,100">
                                        <TextBlock Grid.Column="0" Text="{Binding Id}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="Available" Foreground="#66BB6A"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsAvailable}" />
                                        <TextBlock Grid.Column="2" Text="Borrowed" Foreground="#EF5350"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsAvailable, Converter={x:Static conv:BoolConverters.Not}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>